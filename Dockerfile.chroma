FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 ANONYMIZED_TELEMETRY=False
RUN pip install --no-cache-dir chromadb==1.5.9 && useradd --create-home chroma && mkdir -p /data && chown chroma:chroma /data
USER chroma
EXPOSE 8000
CMD ["chroma", "run", "--host", "0.0.0.0", "--port", "8000", "--path", "/data"]
