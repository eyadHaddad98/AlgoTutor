              "minItems": 1,
              "maxItems": 16
            },
            "directed": {
              "type": "boolean"
            },
            "edges": {
              "type": "array",
              "maxItems": 60,
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "number"
                  }
                },
                "required": [
                  "from",
                  "to",
                  "weight"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
